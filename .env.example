# Usado pelo docker-compose (docker compose le automaticamente um arquivo ".env" nesta pasta).
# Copie para ".env" e preencha antes de rodar `docker compose up`.

# JSON da service account do Firebase Admin, em uma unica linha (Firebase Console >
# Configuracoes do projeto > Contas de servico > Gerar nova chave privada).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Emails Google que serao usados para logar (1 por unidade, usados pelo prisma db seed).
SEED_USER_1_EMAIL="voce+centro@gmail.com"
SEED_USER_2_EMAIL="voce+zonasul@gmail.com"
