# Config web do Firebase (Firebase Console > Configuracoes do projeto > Seus apps > SDK setup).
# Sao valores publicos por design (identificam o projeto, nao dao acesso privilegiado).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL publica da API backend (local: http://localhost:3001, producao: URL do Fly.io)
NEXT_PUBLIC_API_URL=http://localhost:3001
