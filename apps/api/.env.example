# Postgres connection string (docker-compose fornece isso automaticamente para o container da API)
DATABASE_URL="postgresql://e3:e3@localhost:5432/e3_crm?schema=public"

# Porta do servidor HTTP
PORT=3001

# Origem(ns) permitida(s) para CORS (frontend), separadas por virgula
CORS_ORIGIN="http://localhost:3000"

# Firebase Admin: cole aqui o JSON da service account (Firebase Console > Configuracoes do projeto >
# Contas de servico > Gerar nova chave privada), como uma unica linha.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Emails Google usados no seed (1 usuario por unidade, para demonstrar isolamento)
SEED_USER_1_EMAIL="voce+centro@gmail.com"
SEED_USER_2_EMAIL="voce+zonasul@gmail.com"

LOG_LEVEL=info
NODE_ENV=development
